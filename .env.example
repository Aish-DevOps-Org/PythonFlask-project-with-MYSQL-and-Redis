# Copy this file to .env before running.
# For docker-compose: DB_HOST/REDIS_HOST must match the service names below.
# For local (non-Docker) runs: use localhost instead.

PORT=5000

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=changeme
DB_NAME=appdb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Cache behavior
CACHE_TTL_SECONDS=10
